# ---- backend/.env (NEVER commit; NEVER put these in the mobile app) ----
GNANI_API_KEY=            # from app.gnani.ai dashboard
APP_TOKEN=change-me       # shared secret the app sends as X-App-Token
LLM_PROVIDER=rules        # rules | gemini   (start with rules; switch to gemini once the loop works)
GEMINI_API_KEY=
GEMINI_MODEL=             # pick a current free-tier flash model id from Google AI Studio
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_CONCURRENCY=1       # raise only if your account allows parallel requests
# ---- app/.env ----
EXPO_PUBLIC_API_BASE=https://YOUR-BACKEND.onrender.com
EXPO_PUBLIC_APP_TOKEN=change-me
