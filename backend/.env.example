# ---------- HisaabBol backend (copy to .env and fill) ----------
GNANI_API_KEY=                 # app.gnani.ai -> API key (Prisma STT + Timbre TTS)
GNANI_STT_MODEL=prisma-v3.0    # prisma-v3.0 (multi-language + codemix) | prisma-v2.5 (single language)
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_CONCURRENCY=1            # docs: some accounts allow ONE active request; raise only if yours allows more
GNANI_MOCK=false               # true = fake STT/TTS for offline demos/tests (responses are flagged provider="mock")

LLM_PROVIDER=rules             # rules | gemini   (rules works with no key; gemini = better understanding)
GEMINI_API_KEY=
GEMINI_MODEL=                  # a current free-tier flash model id from Google AI Studio

DB_PATH=./data/hisaabbol.db    # SQLite. On Render/Fly mount a persistent disk here, or data resets on redeploy
REGISTRATION_KEY=              # if set, POST /auth/register requires header X-Registration-Key (use in production)
DEMO_ENABLED=true              # enables /demo/* endpoints (sample month, simulated payments). false in production
RATE_LIMIT_PER_MIN=120
GNANI_RATE_PER_MIN=20
MAX_AUDIO_BYTES=5242880
